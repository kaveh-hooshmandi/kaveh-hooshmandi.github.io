\newcount\hours
\newcount\minutes
\hours=\time
\divide\hours by 60
\minutes=\time
\multiply\hours by 60
\advance\minutes by -\hours
\divide\hours by 60
\def\currenttime{\ifnum \hours < 10%
		     0%
		 \fi%
		 \number\hours:%
		 \ifnum\minutes < 10%
		     0%
		 \fi%
		 \number\minutes}%

